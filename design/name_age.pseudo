START name_age

    SET CURRENT_YEAR = system date (year only)

    PUT "What is your name? "
    GET user_name

    PUT "How old are you? "
    GET user_age

    SET birth_year = CURRENT_YEAR - user_age

    PUT "Hello {user_name}! You were born in {birth_year}."

END name_age


