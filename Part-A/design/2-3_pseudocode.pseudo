START name_age

    # Declare constants and variables
    LET user_name as a string
    LET user_age as an integer
    LET birth_year as an integer

    # Get the current year from the system
    LET CURRENT_YEAR = system date (year only)

    # Get user's input
    PUT "What is your name? "
    GET user_name as a string

    PUT "How old are you? "
    GET user_age as an integer

    # Calculate user's birth year
    LET birth_year = CURRENT_YEAR - user_age

    # Output results
    PUT "Hello {user_name}! You were born in {birth_year}."

END name_age


